use clap::{Args, Parser, Subcommand};

#[derive(Parser, Debug)]
#[command(
    name = "{var}tool.bin{/var}",
    version = "{var}tool.version{/var}",
    about = "{var}tool.description{/var}"
)]
struct Cli {
{if}global_flags
{rep}global_flags
    #[arg({if}short short='{var}short{/var}', {/if}long="{var}long{/var}", help="{var}help{/var}")]
    {var}ident{/var}: bool,
{/rep}
{/if}

{if}global_options
{rep}global_options
    #[arg(
        {if}short short='{var}short{/var}', {/if}
        long="{var}long{/var}"
{if}default
        , default_value="{var}default{/var}"
{/if}
        , help="{var}help{/var}"
    )]
{if}required
    {var}ident{/var}: {var}type{/var},
{/if}
{if}optional
    {var}ident{/var}: Option<{var}type{/var}>,
{/if}
{/rep}
{/if}

    #[command(subcommand)]
    command: Commands,
}

#[derive(Subcommand, Debug)]
enum Commands {
{rep}commands
    /// {var}summary{/var}
    {var}ident{/var}({var}ident{/var}Args),
{/rep}
}

{rep}commands
#[derive(Args, Debug)]
struct {var}ident{/var}Args {
{if}subcommands
    #[command(subcommand)]
    subcommand: {var}ident{/var}Subcommand,
{/if}

{if}flags
{rep}flags
    #[arg({if}short short='{var}short{/var}', {/if}long="{var}long{/var}", help="{var}help{/var}")]
    {var}ident{/var}: bool,
{/rep}
{/if}

{if}options
{rep}options
    #[arg(
        {if}short short='{var}short{/var}', {/if}
        long="{var}long{/var}"
{if}default
        , default_value="{var}default{/var}"
{/if}
        , help="{var}help{/var}"
    )]
{if}required
    {var}ident{/var}: {var}type{/var},
{/if}
{if}optional
    {var}ident{/var}: Option<{var}type{/var}>,
{/if}
{/rep}
{/if}

{if}args
{rep}args
    #[arg(value_name="{var}name{/var}", help="{var}help{/var}")]
    {var}ident{/var}: String,
{/rep}
{/if}
}

{if}subcommands
#[derive(Subcommand, Debug)]
enum {var}ident{/var}Subcommand {
{rep}subcommands
    /// {var}summary{/var}
    {var}ident{/var}({var}ident{/var}SubArgs),
{/rep}
}

{rep}subcommands
#[derive(Args, Debug)]
struct {var}ident{/var}SubArgs {
{if}flags
{rep}flags
    #[arg({if}short short='{var}short{/var}', {/if}long="{var}long{/var}", help="{var}help{/var}")]
    {var}ident{/var}: bool,
{/rep}
{/if}

{if}options
{rep}options
    #[arg(
        {if}short short='{var}short{/var}', {/if}
        long="{var}long{/var}"
{if}default
        , default_value="{var}default{/var}"
{/if}
        , help="{var}help{/var}"
    )]
{if}required
    {var}ident{/var}: {var}type{/var},
{/if}
{if}optional
    {var}ident{/var}: Option<{var}type{/var}>,
{/if}
{/rep}
{/if}

{if}args
{rep}args
    #[arg(value_name="{var}name{/var}", help="{var}help{/var}")]
    {var}ident{/var}: String,
{/rep}
{/if}
}
{/rep}
{/if}

{/rep}

fn main() {
    let cli = Cli::parse();

    match cli.command {
{rep}commands
{if}subcommands
        Commands::{var}ident{/var}(_args) => {
            use {var}ident{/var}Subcommand::*;
            match _args.subcommand {
{rep}subcommands
                {var}ident{/var}(_sub_args) => {
                    println!("{var}name{/var}: TODO");
                }
{/rep}
            }
        }
{/if}
{if}no_subcommands
        Commands::{var}ident{/var}(_args) => {
            println!("{var}name{/var}: TODO");
        }
{/if}
{/rep}
    }
}

