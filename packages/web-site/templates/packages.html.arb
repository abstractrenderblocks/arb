<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{var}site.name{/var} - {var}packages.title{/var}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="stylesheet" href="site.css" />
</head>
<body>

<header>
  <div class="wrap">
    <h1>{var}site.name{/var}</h1>
    <p>{var}site.tagline{/var}</p>

    <nav>
{rep}navigation
      <a href="{var}href{/var}">{var}label{/var}</a>
{/rep}
    </nav>
  </div>
</header>

<main>
  <div class="wrap">
    <h2>{var}packages.title{/var}</h2>
    <div class="md">{var}packages.intro{/var}</div>

{rep}packages.items
    <section>
      <h3>{var}name{/var}</h3>
      <div class="md">Path: {var}path{/var}</div>
      <div class="md">{var}purpose{/var}</div>
      <div class="md">How to use: {var}usage{/var}</div>
    </section>
{/rep}
  </div>
</main>

<footer>
  <div class="wrap">
    <p>
      <a href="{var}site.repository{/var}">GitHub</a> - {var}site.domain{/var}
    </p>
  </div>
</footer>

</body>
</html>
